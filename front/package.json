{
  "name": "next-app-template",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings=0",
    "prettier": "prettier -w .",
    "prettier-ci": "prettier --check .",
    "prod": "python -m http.server 3000 --directory ./out"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/rss": "^0.0.32",
    "@types/sql.js": "^1.4.9",
    "autoprefixer": "10.4.16",
    "better-sqlite3": "12.11.1",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.29",
    "intl-messageformat": "^10.5.0",
    "next": "15.5.29",
    "postcss": "^8.5.32",
    "prettier": "^3.2.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rss": "^1.2.2",
    "sql.js": "^1.13.0",
    "typescript": "^5.0.4",
    "use-debounce": "^10.0.4"
  },
  "devDependencies": {
    "eslint-config-prettier": "^9.1.0"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
